{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (Express)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        }
      },
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        }
      },
      "presentation": {
        "group": "servers",
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start Full Stack (EstateHub)",
      "dependsOn": ["Start Backend (Express)", "Start Frontend (Vite)"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
